/*
  x-robots-tag: index, follow

# Content-hashed bundles never change under a given URL — cache hard.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images are stable but may be re-optimized; cache a month, revalidate after.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Feeds refresh with new posts — short cache.
/blog-rss.xml
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
